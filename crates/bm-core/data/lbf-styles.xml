<xml>
<!-- The styles that refreshable braille (.lbf) output writes markup for: before the style's text, at each new
     line within it, and after it; hierarchy styles number their levels from toplevel; requiretext True waits for
     text before writing "before". Matched by style name in small letters. -->
  <style name ="Attribution.">
    <before> $p </before>
    <hierarchy>False</hierarchy>
    <toplevel></toplevel>
    <newline></newline>
    <after> $p= </after>
    <requiretext>True</requiretext>
  </style>
  <style name ="BB-BoxBegin.">
    <before> $b </before>
    <hierarchy>False</hierarchy>
    <toplevel></toplevel>
    <newline></newline>
    <after></after>
    <requiretext>False</requiretext>
  </style>
  <style name ="BE-BoxEnd.">
    <before> $b= </before>
    <hierarchy>False</hierarchy>
    <toplevel></toplevel>
    <newline></newline>
    <after></after>
    <requiretext>False</requiretext>
  </style>
  <style name ="BL-BlockProtectlevel.">
    <before></before>
    <hierarchy>False</hierarchy>
    <toplevel></toplevel>
    <newline></newline>
    <after> $b= </after>
    <requiretext>True</requiretext>
  </style>
