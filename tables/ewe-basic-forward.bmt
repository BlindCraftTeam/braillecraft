scan paragraph "p"
scan new-paragraphs 0
scan rejoin-hyphens 0
scan spaces 0
scan tab-width 1
scan ninmod 0
scan fold-codes 1
scan fold-words 1
scan capital-cessation 1
scan map-braces 0
scan font "fts~i fte~i 4 3"
scan font "fts~b fte~b 4 4"
scan font "fts~u fte~u 4 3"
scan font "fts~s fte~s 4 3"
scan spare 0
scan passage-ends 0
scan nxsls 0
scan format-word 28
scan format-word2 27
scan capital-sign 1
scan capital-end 2
scan address-switching 0
scan mode-words "running" "spacing" "marking" "as-is" "compress" "sentence" "auto-tab" "par" "no-par" "par-skp" "par-ind"
scan passage-words 0
scan doubled-adjectives 0
