# The rules of qqdisu.btb and gendxp.sct, recreated as BrailleMaker table source.
table "qqdisu, print to braille"
default-char 42
raw 0
writer 0
output 4
tail-extra 0 0 0
unknown 4

state s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16
state s17 s18 s19 s20 s21 s22 s23 s24 s25 s26 s27 s28 s29 s30 s31 s32
state s33 s34 s35 s36 s37 s38 s39 s40 s41 s42 s43 s44 s45 s46 s47 s48
state s49 s50 s51 s52 s53 s54 s55 s56 s57 s58 s59 s60 s61 s62 s63 s64

class c00 "\x0a\x0d "
class c01 "\x0a\x0d "
class c02 "\x0a\x0d "
class c03 "\x0a\x0d "
class c04 ""
class c05 ""
class c06 ""
class c07 ""
class c08 ""
class c09 ""
class c10 ""
class c11 ""
class c12 ""
class c13 ""
class c14 ""
class c15 ""
class c16 ""
class c17 ""
class c18 ""
class c19 ""
class c20 ""
class c21 ""
class c22 ""
class c23 ""
class c24 ""
class c25 ""
class c26 ""
class c27 ""
class c28 ""
class c29 ""
class c30 ""
class c31 ""
class c32 ""
class c33 ""
class c34 ""
class c35 ""
class c36 ""
class c37 ""
class c38 ""
class c39 ""
class c40 ""
class c41 ""
class c42 ""
class c43 ""
class c44 ""
class c45 ""
class c46 ""
class c47 ""
class c48 ""
class c49 ""
class c50 ""
class c51 ""
class c52 ""
class c53 ""
class c54 ""
class c55 ""
class c56 ""
class c57 ""
class c58 ""
class c59 ""
class c60 ""
class c61 ""
class c62 ""
class c63 ""

set x0 = 

result 1

char "\x0a" default " " rules 1
char "\x0d" default " " rules 2
char " " default " " rules 3
unknown-record default " " rules 3

node 1 "" none result 1 consume 1 -> " <lf> " end
node 2 "" none result 1 consume 1 -> " <cr> " end
node 3 "" none result 1 consume 1 -> " <sp> " end

scan input-mode 0
scan trailing-blanks 1
scan flag 28
scan full-stop 46
scan newline 1
scan form-feed "\x15"
scan paragraph "p"
scan new-paragraphs 0
scan rejoin-hyphens 0
scan spaces 0
scan tab-width 1
scan ninmod 0
scan fold-codes 1
scan fold-words 1
scan capital-cessation 1
scan map-braces 0
scan font "fts~i fte~i 4 3"
scan font "fts~b fte~b 4 4"
scan font "fts~u fte~u 4 3"
scan font "fts~s fte~s 4 3"
scan spare 0
scan passage-ends 0
scan nxsls 0
scan format-word 28
scan format-word2 27
scan capital-sign 1
scan capital-end 2
scan address-switching 0
scan mode-words "running" "spacing" "marking" "as-is" "compress" "sentence" "auto-tab" "par" "no-par" "par-skp" "par-ind"
scan passage-words 0
scan doubled-adjectives 0
