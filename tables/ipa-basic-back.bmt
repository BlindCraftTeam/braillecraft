scan full-stop 46
scan newline 1
scan form-feed "\x15"
scan paragraph "p"
scan new-paragraphs 0
scan rejoin-hyphens 0
scan spaces 0
scan tab-width 1
scan ninmod 0
scan fold-codes 1
scan fold-words 1
scan capital-cessation 0
scan map-braces 0
scan spare 0
scan passage-ends 0
scan nxsls 0
scan format-word 28
scan format-word2 27
scan capital-sign 0
scan capital-end 0
scan address-switching 0
scan mode-words "running" "spacing" "marking" "as-is" "compress" "sentence" "auto-tab" "par" "no-par" "par-skp" "par-ind"
scan passage-words 0
scan doubled-adjectives 0
