node 1 "e\x1f" short-set @x2 result 2 consume 3 -> "\x1ce~overrightarrow[\x1f" next 31
node 2 "\x1f" short-set @x5 result 2 consume 3 -> "\x1ce~dot[\x1f" level 3
node 3 "" short-set @x6 result 2 consume 3 -> "\x1ce~overline[\x1f" next 4
node 4 "" short-set @x7 result 2 consume 3 -> "\x1ce~overline[\x1f" next 5
node 5 "" short-set @x8 result 2 consume 3 -> "\x1ce~overline[\x1f" next 6
