node 28 "4" short-set @x0 result 1 consume 3 -> "" next 29
node 29 "5" short-set @x0 result 1 consume 3 -> "" next 30
node 30 "6" short-set @x0 result 1 consume 3 -> "" level 1
node 31 "bar\x1f" none result 3 consume 5 -> "\x1cbar~]\x1f" next 32
node 32 "os\x1f" none result 3 consume 4 -> "\x1cos~]\x1f" next 33
node 33 "us\x1f" none result 5 consume 4 -> "\x1cus~]\x1f" end

scan input-mode 0
scan trailing-blanks 1
scan flag 28
scan full-stop 46
scan newline 1
scan form-feed "\x15"
scan paragraph "p"
scan new-paragraphs 0
scan rejoin-hyphens 0
scan spaces 0
scan tab-width 1
scan ninmod 0
scan fold-codes 1
scan fold-words 1
scan capital-cessation 1
scan map-braces 0
scan font "fts~i fte~i 4 3"
scan font "fts~b fte~b 4 4"
scan font "fts~u fte~u 4 3"
scan font "fts~s fte~s 4 3"
scan spare 0
scan passage-ends 0
scan nxsls 0
scan format-word 28
scan format-word2 27
scan capital-sign 1
scan capital-end 2
scan address-switching 0
scan mode-words "running" "spacing" "marking" "as-is" "compress" "sentence" "auto-tab" "par" "no-par" "par-skp" "par-ind"
scan passage-words 0
scan doubled-adjectives 0
