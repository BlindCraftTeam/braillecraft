set x0 = "\x1c" "u" "s" "\x1f" | "\x1c" "o" "s" "\x1f"
set x1 = c00 | c01 c00
set x2 = "\x1c" "o" "s" "\x1f" "\xef" "B" "\x1c" "o" "e" "\x1f" | @x1 @x2 | @x3 @x2
set x3 = "\x1c" "i" "x" "r" "t" "d" "\x1f" | "\x1c" "i" "x" "r" "t" "e" "\x1f" | "\x1c" "i" "x" "r" "t" "s" "\x1f" | "\x1c" "f" "e" "\x1f" | "\x1c" "f" "l" "s" "\x1f" | "\x1c" "f" "l" "\x1f" | "\x1c" "f" "s" "\x1f" | "\x1c" "f" "t" "e" "~" c00 "\x1f" | "\x1c" "f" "t" "s" "~" c00 "\x1f" | "\x1c" "b" "e" "\x1f" | "\x1c" "b" "s" "\x1f" | "\x1c" "p" "e" "\x1f" | "\x1c" "p" "s" "\x1f" | "\x1c" "s" "q" "r" "t" "e" "\x1f" | "\x1c" "s" "q" "r" "t" "s" "\x1f"
set x4 = "\x1c" "u" "s" "\x1f" "\xec" "E" "\x1c" "u" "e" "\x1f" | @x1 @x4 | @x3 @x4
set x5 = "\x1c" "o" "s" "\x1f" "\xf1" "K" "\x1c" "o" "e" "\x1f" | @x1 @x5 | @x3 @x5
set x6 = "\x1c" "b" "a" "r" "\x1f" | @x1 @x6 | @x3 @x6
set x7 = "\x1c" "o" "s" "\x1f" "\x1c" "b" "a" "r" "\x1f" "\x1c" "o" "e" "\x1f" | @x1 @x7 | @x3 @x7
set x8 = "\x1c" "o" "s" "\x1f" "\xec" "E" "\x1c" "o" "e" "\x1f" | @x1 @x8 | @x3 @x8
set x9 = "\x1c" "o" "s" "\x1f" "\xef" "@" "\x1c" "o" "e" "\x1f" | @x1 @x9 | @x3 @x9
set x10 = "\x1c" "o" "s" "\x1f" "\xef" "D" "\x1c" "o" "e" "\x1f" | @x1 @x10 | @x3 @x10
set x11 = "\x1c" "u" "s" "\x1f" "\xef" "@" "\x1c" "u" "e" "\x1f" | @x1 @x11 | @x3 @x11
set x12 = "\x1c" "u" "s" "\x1f" "\xef" "D" "\x1c" "u" "e" "\x1f" | @x1 @x12 | @x3 @x12
set x13 = "\x1c" "u" "s" "\x1f" "\xef" "B" "\x1c" "u" "e" "\x1f" | @x1 @x13 | @x3 @x13
set x14 = "\x1c" "o" "s" "\x1f" "\xf2" "B" "\x1c" "o" "e" "\x1f" | @x1 @x14 | @x3 @x14
set x15 = "\x1c" "o" "s" "\x1f" "~" "\x1c" "o" "e" "\x1f" | @x1 @x15 | @x3 @x15

result 1
result 2 then set s1
result 3 when s1 then clear s1
result 4 then set s2
result 5 when s2 then clear s2

