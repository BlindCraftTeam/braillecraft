<?xml version="1.0" encoding="utf-8" ?>
<QuickSettings>
	<QuickSettingsDefinitions 
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" >
		<Category ID="BrailleCraftOptions">
			<Setting ID="BrailleCraftOptions.BrailleLineSpeakingLevel" Type="List">
				<Values>
					<Value ID="BrailleCraftOptions.BrailleLineSpeakingLevel.0" Index="1" />
			<Value ID="BrailleCraftOptions.BrailleLineSpeakingLevel.1" Index="2" />
					<Value ID="BrailleCraftOptions.BrailleLineSpeakingLevel.2" Index="3" />
				</Values>
				<SettingsFile Section="NonJCFOptions" Name="BrailleLineSpeakingLevel" />
			</Setting>
			<Setting ID="BrailleCraftOptions.BrailleDocInputEcho" Type="List">
				<Values>
					<Value ID="BrailleCraftOptions.BrailleDocInputEcho.0" Index="1" />
			<Value ID="BrailleCraftOptions.BrailleDocInputEcho.1" Index="2" />
					<Value ID="BrailleCraftOptions.BrailleDocInputEcho.2" Index="3" />
					<Value ID="BrailleCraftOptions.BrailleDocInputEcho.3" Index="4" />
					<Value ID="BrailleCraftOptions.BrailleDocInputEcho.4" Index="5" />
				</Values>
				<SettingsFile Section="NonJCFOptions" Name="BrailleDocInputEcho" />
			</Setting>
			<Setting ID="BrailleCraftOptions.SpeakBrailleCharsAsLocalBrailleSigns" Type="Boolean">
								<SettingsFile Section="NonJCFOptions" Name="SpeakBrailleCharsAsLocalBrailleSigns" />
			</Setting>
			<Setting ID="BrailleCraftOptions.AnnounceStyleChanges" Type="Boolean">
								<SettingsFile Section="NonJCFOptions" Name="AnnounceStyleChanges" />
			</Setting>
			<Setting ID="BrailleCraftOptions.AnnounceForcedLineSkips" Type="Boolean">
								<SettingsFile Section="NonJCFOptions" Name="AnnounceForcedLineSkips" />
			</Setting>
			<Setting ID="BrailleCraftOptions.ShowRequestedStatusInfoOnBrailleDisplay" Type="Boolean">
				<SettingsFile Section="NonJCFOptions" Name="ShowRequestedStatusInfoOnBrailleDisplay" />
			</Setting>
					<Setting ID="BrailleCraftOptions.SpeakPrintLinesByWord" Type="Boolean">
				<SettingsFile Section="NonJCFOptions" Name="SpeakPrintLinesByWord" />
			</Setting>
					<Setting ID="BrailleCraftOptions.UseStatusLineForUnicodeValues" Type="Boolean">
				<SettingsFile Section="NonJCFOptions" Name="UseStatusLineForUnicodeValues" />
			</Setting>
</Category>
	</QuickSettingsDefinitions>
